{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Editor",
  "version": "0.8.0",
  "identifier": "com.eirik.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Editor",
        "width": 1200,
        "height": 850,
        "minWidth": 480,
        "minHeight": 360,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data: https: http:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost ws://127.0.0.1:*",
        "frame-src": "http://preview.localhost preview:",
        "worker-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Markdown-editor",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown",
        "description": "Markdown-dokument",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5NTIyMURFOTBFMzQ4NEUKUldST1NPT1EzaUZTeVppeW5ndWlyem9icFcvWkVhbXZjWmZWWEFuSXh3eEZCSjlBQ3htdUxPVHAK",
      "endpoints": [
        "https://github.com/esv25/editor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
